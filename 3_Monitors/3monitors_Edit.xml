<?xml version="1.0"?>
<PropertyList>

  <nasal>
    <view_override>
      <script>

        var apply_my_view = func 
        {
          setprop("/sim/current-view/x-offset-m", -0.21);
          setprop("/sim/current-view/y-offset-m", 0.443);
          setprop("/sim/current-view/z-offset-m", -0.11);
          print("CUSTOM VIEW APPLIED");
        };
        
        setlistener("/sim/signals/fdm-initialized", func 
        {
          settimer(apply_my_view, 5.0); 
        });

      </script>
    </view_override>
  </nasal>

  <sim>
    <rendering>
      <camera-group>

        <window>

          <name>mainwindow</name>
          <display>0</display>
          <screen>0</screen>
          <x>-1920</x> 
          <y>0</y>
          <width>5760</width>
          <height>1200</height>
          <fullscreen type="bool">false</fullscreen> 
          <decoration type="bool">false</decoration> 

        </window>

        <camera>
          <window><name>mainwindow</name></window>
          <viewport>
            <x>0</x>
            <y>0</y>
            <width>1920</width>
            <height>1200</height>
          </viewport>
          <view>
            <heading-deg type="double">60.0</heading-deg> 
          </view>
          <frustum>
            <top>0.1443</top><bottom>-0.1443</bottom><left>-0.2309</left><right>0.2309</right><near>0.4</near><far>120000.0</far>
          </frustum>
        </camera>

        <camera>
          <window><name>mainwindow</name></window>
          <viewport>
            <x>1920</x>
            <y>0</y>
            <width>1920</width>
            <height>1200</height>
          </viewport>
          <view>
            <heading-deg type="double">0.0</heading-deg>
          </view>
          <frustum>
            <top>0.1443</top><bottom>-0.1443</bottom><left>-0.2309</left><right>0.2309</right><near>0.4</near><far>120000.0</far>
          </frustum>
        </camera>

        <camera>
          <window><name>mainwindow</name></window>
          <viewport>
            <x>3840</x>
            <y>0</y>
            <width>1920</width>
            <height>1200</height>
          </viewport>
          <view>
            <heading-deg type="double">-60.0</heading-deg>
          </view>
          <frustum>
            <top>0.1443</top><bottom>-0.1443</bottom><left>-0.2309</left><right>0.2309</right><near>0.4</near><far>120000.0</far>
          </frustum>
        </camera>

        <gui>
          <window><name>mainwindow</name></window>
        </gui>

      </camera-group>
    </rendering>
  </sim>
</PropertyList>